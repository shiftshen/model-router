{
  "name": "model-router-engine",
  "version": "0.2.0",
  "description": "Advisory model routing with local Laya Typed-Decisions and Jev fallback",
  "type": "module",
  "bin": {
    "model-router-engine": "./bin/model-router-engine.mjs"
  },
  "exports": {
    ".": "./src/engine.mjs",
    "./core": "./src/routing-index.mjs",
    "./dispatch": "./src/dispatch.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "compare": "node bin/model-router-engine.mjs compare < examples/compare.json",
    "check": "node --check bin/model-router-engine.mjs && node --check src/engine.mjs && node --check src/dispatch.mjs && npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "license": "MIT"
}
